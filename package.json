{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@luolapeikko/express-standard-schema",
  "version": "0.0.14",
  "description": "ExpressJS Standard Schema Validation Middleware",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "test": "vitest test --typecheck --run --no-isolate --coverage",
    "lint": "biome check",
    "validate": "tsc --noEmit --project tsconfig.test.json"
  },
  "repository": "github:luolapeikko/express-standard-schema",
  "keywords": [
    "zod",
    "valibot",
    "arktype",
    "express",
    "middleware",
    "validation",
    "standard-schema"
  ],
  "author": "mharj",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@standard-schema/spec": "^1.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^25.9.8",
    "@vitest/coverage-v8": "^5.0.3",
    "c8": "^12.0.0",
    "express": "^5.2.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/express": ">= 4.0.0",
    "@types/express-serve-static-core": ">= 4.0.0",
    "express": ">= 4.0.0"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
